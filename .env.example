# Anthropic (Claude agent model + Haiku judge). If your key is not workspace-scoped, set the workspace id.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Fireworks (GLM-5.3 agent model + Qwen3 embeddings)
FIREWORKS_API_KEY=
FIREWORKS_LLM_MODEL=accounts/fireworks/models/glm-5p3
FIREWORKS_EMBEDDING_MODEL=accounts/fireworks/models/qwen3-embedding-8b

# LangSmith (tracing, datasets, experiments, annotation queues)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=Focused
LANGSMITH_WORKSPACE_ID=

# Agent / judge selection
AGENT_MODEL=claude         # claude | glm
JUDGE_MODEL=claude-haiku-4-5

# Optional (post-MVP): TypeSafe Jev decision model
# JEV_API_KEY=
